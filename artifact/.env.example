# ══════════════════════════════════════════════════════════════════════════════
#  ANCHOR — Environment Configuration
#  Copy this file to .env and fill in your values.
#
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
#  ANCHOR Text-to-Ontology Pipeline
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: vllm | openai | anthropic
#
# ANCHOR is provider-agnostic. Any of the three options below drives the same
# pipeline, so an artifact evaluator may use whichever endpoint they already
# have. Pick ONE and fill in only that block:
#
#   vllm       Any OpenAI-compatible server that supports tool calling.
#              This is what the paper's measurements used; see VLLM_SETUP.md.
#              Requires your own GPU server.
#   openai     A hosted OpenAI-compatible API. No GPU needed.
#   anthropic  The Anthropic Messages API. No GPU needed.
#
# The paper's numbers come from a locally served Qwen/Qwen3.5-35B-A3B-FP8. For
# the Functional check, which only asserts that the pipeline runs end to end and
# emits a structurally valid graph, ANY sufficiently capable tool-calling model
# is acceptable. Substituting a model changes the extracted content, not the
# structural validity that the check verifies.
LLM_PROVIDER=vllm

# ── vLLM / any OpenAI-compatible server (LLM_PROVIDER=vllm) ──────────────────
# Reference configuration used for the paper (see VLLM_SETUP.md).
VLLM_BASE_URL=http://127.0.0.1:8081/v1
VLLM_API_KEY=dummy                  # set to anything if auth is disabled
VLLM_LLM_MODEL=qwen3.5-35b          # must match the server's --served-model-name
VLLM_THINKING=false                 # true: enable Qwen3 reasoning | false: faster

# VLLM_THINKING is implemented with vLLM's `chat_template_kwargs` extension, which
# is not part of the OpenAI schema. Tolerant servers ignore it; strict ones
# answer HTTP 400 for unknown body fields. ANCHOR detects that and retries
# without the field automatically, printing one warning. Set
# VLLM_EXTRA_BODY=false to suppress the field (and the warning) from the start.
#
# On a server that ignores the field, this toggle has NO effect: a reasoning
# model keeps emitting thinking tokens, which count against LLM_MAX_TOKENS and
# can truncate its JSON. Raise LLM_MAX_TOKENS or use a non-reasoning model.
#VLLM_EXTRA_BODY=false

# ── OpenAI (LLM_PROVIDER=openai) ─────────────────────────────────────────────
# No GPU required. Use a tool-calling-capable model.
# The model names below are EXAMPLES. Replace them with a current model your
# account can access; scripts/check_endpoint.py lists the available names if the
# configured one is not found.
OPENAI_API_KEY=sk-...
OPENAI_LLM_MODEL=gpt-4o
#OPENAI_BASE_URL=https://api.openai.com/v1   # override for a compatible gateway

# ── Anthropic (LLM_PROVIDER=anthropic) ───────────────────────────────────────
# No GPU required. The model name below is an EXAMPLE — replace it with a
# current model your account can access. scripts/check_endpoint.py lists the
# models the key can see if the configured one is not among them.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_LLM_MODEL=claude-sonnet-4-6

# ── Token limits ──────────────────────────────────────────────────────────────
# REQUIRED for vLLM to prevent infinite generation.
LLM_MAX_TOKENS=2048
MAPPER_MAX_TOKENS=16384
MAPPER_TIMEOUT=600

# ── Ontology MCP Server ───────────────────────────────────────────────────────
# Path to ontology-mcp-server/main.py. The server is vendored in mcp/ as plain
# files (NOT a git submodule); the default relative path below works as shipped.
MCP_SERVER_SCRIPT=./mcp/ontology-mcp-server/main.py

# Absolute path to the ontology schema folder to load
# Available: ontology/uco | ontology/stix | ontology/malont
ONTOLOGY_DIR=./ontology/uco

# Sentence-transformer model for semantic search (cached after first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Device for embedding model: cpu | cuda | mps
EMBEDDING_DEVICE=cpu

# Enable export_eval_json tool (required for final JSON export via MCP)
ENABLE_EVAL_TOOLS=true

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output

# ── Optional MCP scoring constants (defaults shown) ──────────────────────────
# Override via CLI flags (--emb-threshold / --name-weight / --keyword-bonus)
# or set here to change defaults across all runs.
#LOW_CONFIDENCE_CLASS_THRESHOLD=0.45  # search_classes cutoff (default: 0.45)
#LOW_CONFIDENCE_PROP_THRESHOLD=0.3   # search_attributes/search_relations cutoff (default: 0.3)
#EMB_NAME_WEIGHT=0.5
#KEYWORD_BONUS=0.3
#DATATYPE_MATCH_BOOST=0.2
#DIRECT_RELATION_BOOST=0.1
#RANGE_MATCH_BOOST=0.15
#INVERSE_RELATION_PENALTY=0.05
#SEMANTIC_MATCH_THRESHOLD=0.6
# Max properties shown per section in recurse_* tool output (default: 20)
#RECURSE_SECTION_CAP=20
# Write .cypher file alongside JSON output (set by --export-cypher flag)
#EXPORT_CYPHER=false
